#!/bin/sh
set -eu

if [ -z "${GHDL_EXE:-}" ]; then
  if [ -x "/c/code/ghdl-mcode-5.1.1-mingw64/bin/ghdl.exe" ]; then
    GHDL_EXE="/c/code/ghdl-mcode-5.1.1-mingw64/bin/ghdl.exe"
  else
    GHDL_EXE="ghdl"
  fi
fi

echo "Running GHDL tests before push..."

"$GHDL_EXE" -a --std=08 \
  src/mc68881_pkg.vhd \
  src/mc68881_modrem_post_unit.vhd \
  src/mc68881_divrem_unit.vhd \
  src/mc68881_trig_unit.vhd \
  src/mc68881_sgl_ops_unit.vhd \
  src/mc68881_alu.vhd \
  src/mc68881_top.vhd \
  tb/mc68881_golden_vectors_pkg.vhd \
  tb/tb_mc68881_alu.vhd \
  tb/tb_mc68881_top.vhd

"$GHDL_EXE" -e --std=08 tb_mc68881_alu
"$GHDL_EXE" -r --std=08 tb_mc68881_alu --assert-level=error

"$GHDL_EXE" -e --std=08 tb_mc68881_top
"$GHDL_EXE" -r --std=08 tb_mc68881_top --assert-level=error

echo "GHDL tests passed."
